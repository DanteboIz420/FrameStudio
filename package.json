{
  "name": "frame-studio",
  "version": "1.3.0",
  "description": "A personal studio for beautifully framed screen recordings",
  "main": "main.cjs",
  "author": "DanteboIz420",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/model.test.mjs tests/options.test.mjs",
    "test:app": "node tests/app.cjs",
    "build": "electron-builder --win dir",
    "test:regressions": "node tests/regressions.cjs",
    "test:features": "node tests/features.cjs",
    "setup:engine": "node scripts/setup-engine.cjs",
    "test:setup": "node --test tests/engine.test.cjs",
    "package:release": "node scripts/package-release.cjs",
    "format": "prettier --write .",
    "test:compositions": "node tests/compositions.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "sharp": "0.35.5"
  },
  "build": {
    "asar": false,
    "appId": "personal.frame.studio",
    "productName": "Frame Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "native-render.cjs",
      "storage.cjs",
      "engine-setup.cjs",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "engine/ffmpeg-9.0.2-essentials_build/bin",
        "to": "engine",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "engine/ffmpeg-9.0.2-essentials_build",
        "to": "engine",
        "filter": [
          "LICENSE",
          "README.txt"
        ]
      },
      {
        "from": "assets",
        "to": "samples",
        "filter": [
          "*.mp4"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanteboIz420/FrameStudio.git"
  },
  "homepage": "https://github.com/DanteboIz420/FrameStudio#readme",
  "bugs": {
    "url": "https://github.com/DanteboIz420/FrameStudio/issues"
  }
}
